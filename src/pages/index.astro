---
import '../styles/global.css';
import {scenes,evidence,ipca1994} from '../data/chapters';
const meta='Uma história do Brasil explicada por dados, decisões e documentos públicos. Investigação independente, gratuita e verificável.';
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={meta}/><meta name="theme-color" content="#081412"/><meta property="og:title" content="Observatório do Brasil — A história por trás dos números"/><meta property="og:description" content={meta}/><meta property="og:type" content="website"/><link rel="canonical" href="https://taleshenrique.dev/"/><title>Observatório do Brasil — História, dados e evidências</title></head><body><a class="skip" href="#conteudo">Pular para o conteúdo</a><header class="site-header container"><a href="/" class="brand" aria-label="Observatório do Brasil — início">OBSERVATÓRIO<span>.</span> BRASIL</a><nav class="site-nav" aria-label="Navegação principal"><a href="#historia">História</a><a href="#temas">Temas</a><a href="#metodologia">Método</a><a href="#financiamento">Financiamento</a><button class="toggle" type="button" id="contrast" aria-pressed="false">Alto contraste</button></nav></header><main id="conteudo"><section class="hero container" aria-labelledby="hero-title"><span class="eyebrow">O passado explica o presente</span><h1 id="hero-title">O Brasil<br/>em perspectiva<span style="color:var(--accent)">.</span></h1><p>Uma viagem pela história do país. Sem torcidas, sem conclusões prontas. Com contexto, documentos e números que você pode conferir.</p><a class="scroll" href="#historia">Explore o primeiro capítulo ↓</a></section><section id="historia" class="container chapter-intro"><span class="eyebrow">Capítulo 01 / Economia e história / 1993–1994</span><h2>Quando o dinheiro<br/>perdia o valor.</h2><p>Antes de compreender os governos e suas promessas, precisamos voltar a um momento decisivo: a estabilização monetária brasileira. O Plano Real foi um processo com diferentes etapas, não apenas uma nova cédula.</p></section><section class="narrative container" aria-label="Narrativa histórica interativa"><div class="visual-stage"><div class="visual-card"><span class="eyebrow" id="active-year">1993</span><h3 id="active-title">Antes do Real, a inflação moldava o cotidiano</h3><div class="big-number" id="active-metric">1993</div><p class="visual-note" id="active-label">O início desta história</p><div role="img" aria-label="Gráfico de barras do IPCA mensal em 1994: junho 47,43 por cento; julho 6,84 por cento; agosto 1,86 por cento."><div class="bar-chart">{ipca1994.map(({month,value})=><div class="bar-col"><span class="bar-value">{value.toLocaleString('pt-BR',{minimumFractionDigits:2})}%</span><div class="bar" style={`height:${(value/47.43)*100}%`}></div><span class="bar-month">{month}</span></div>)}</div></div><details><summary>Consultar dados do gráfico em tabela</summary><table class="data-table"><caption>IPCA mensal, junho a agosto de 1994 (%)</caption><thead><tr><th scope="col">Mês</th><th scope="col">Variação (%)</th></tr></thead><tbody>{ipca1994.map(({month,value})=><tr><th scope="row">{month}</th><td>{value.toLocaleString('pt-BR',{minimumFractionDigits:2})}</td></tr>)}</tbody></table></details><p class="visual-note">Fonte: <a href={evidence.ibge.url} target="_blank" rel="noopener noreferrer">IBGE/SIDRA — IPCA</a>. Valores sujeitos à conferência editorial antes de citação acadêmica.</p><div class="controls"><button id="prev" type="button" disabled>← Anterior</button><button id="next" type="button">Próxima →</button></div><p class="sr-only" id="scene-announcement" aria-live="polite" aria-atomic="true"></p></div></div><div class="scenes" id="scenes">{scenes.map((scene,i)=><article id={scene.id} data-scene={i} data-year={scene.year} data-title={scene.title} data-metric={scene.metric||scene.year} data-label={scene.metricLabel||scene.eyebrow} aria-labelledby={`title-${scene.id}`}><span class="eyebrow">{scene.eyebrow}</span><h3 id={`title-${scene.id}`}>{scene.title}</h3><p>{scene.description}</p><div class="source-links">{scene.sourceIds.map(key=><a href={evidence[key].url} target="_blank" rel="noopener noreferrer" aria-label={`Fonte: ${evidence[key].institution} — ${evidence[key].title}, abre em nova aba`}>{evidence[key].institution} ↗</a>)}</div></article>)}</div></section><section id="temas" class="section container"><span class="eyebrow">Um país, múltiplas dimensões</span><h2>Os próximos capítulos.</h2><div class="cards"><div class="topic"><span class="eyebrow">01 / Economia</span><h3>Inflação, renda e trabalho</h3><p>Como a economia mudou e quem foi afetado.</p></div><div class="topic"><span class="eyebrow">02 / Sociedade</span><h3>Pobreza e desigualdade</h3><p>As mudanças observadas e seus limites.</p></div><div class="topic"><span class="eyebrow">03 / Serviços públicos</span><h3>Educação e saúde</h3><p>Investimento, acesso e resultados em séries históricas.</p></div></div><p>Essas histórias estão em preparação; não são apresentadas como pesquisas concluídas.</p></section><section id="metodologia" class="section container"><span class="eyebrow">Compromisso editorial</span><h2>Dados não contam<br/>toda a história sozinhos.</h2><p>Separamos promessa eleitoral, decisão oficial, execução e resultado. Preferimos fontes primárias e séries comparáveis. Indicamos limitações, revisões e incertezas; evitamos atribuir causalidade apenas porque um indicador mudou durante um governo.</p><p><a href="https://taleshenrique.dev/politicas-publicas/skill.md">Leia a metodologia pública ↗</a></p></section><aside class="container" aria-label="Informações sobre publicidade"><div class="ad-slot"><span class="eyebrow">Publicidade · espaço reservado</span><p>Nenhum anúncio está ativo. No futuro, eventuais patrocínios serão identificados, discretos e não interromperão a leitura.</p></div></aside><section id="financiamento" class="section container"><span class="eyebrow">Por que este projeto existe</span><h2>Informação livre.<br/>Custos transparentes.</h2><p>O Observatório é gratuito. Se exibirmos publicidade, será para ajudar a cobrir hospedagem, manutenção e pesquisa, sem interferência nas conclusões editoriais. Nesta versão, não carregamos redes de anúncios nem rastreadores publicitários.</p></section></main><footer class="site-footer container">Observatório do Brasil · Pesquisa em desenvolvimento · <a href="https://github.com/Ths33/Politicas-publicas-skill">Código e metodologia no GitHub</a></footer><script>import gsap from 'gsap';import {ScrollTrigger} from 'gsap/ScrollTrigger';const articles=[...document.querySelectorAll('[data-scene]')];const year=document.querySelector('#active-year'),title=document.querySelector('#active-title'),metric=document.querySelector('#active-metric'),label=document.querySelector('#active-label'),announcement=document.querySelector('#scene-announcement'),prev=document.querySelector('#prev'),next=document.querySelector('#next');let active=0;function activate(i,announce=false){active=Math.max(0,Math.min(articles.length-1,i));const el=articles[active];year.textContent=el.dataset.year;title.textContent=el.dataset.title;metric.textContent=el.dataset.metric;label.textContent=el.dataset.label;prev.disabled=active===0;next.disabled=active===articles.length-1;history.replaceState(null,'','#'+el.id);if(announce)announcement.textContent='Cena '+(active+1)+' de '+articles.length+': '+el.dataset.title}function move(delta){const i=Math.max(0,Math.min(articles.length-1,active+delta));activate(i,true);articles[i].scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})}prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));const contrast=document.querySelector('#contrast');contrast.addEventListener('click',()=>{const on=document.documentElement.classList.toggle('high-contrast');contrast.setAttribute('aria-pressed',String(on))});const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;if(!reduced){gsap.registerPlugin(ScrollTrigger);articles.forEach((el,i)=>ScrollTrigger.create({trigger:el,start:'top 50%',end:'bottom 50%',onEnter:()=>activate(i),onEnterBack:()=>activate(i)}))}else{const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)activate(Number(e.target.dataset.scene))}),{rootMargin:'-40% 0px -40% 0px'});articles.forEach(el=>observer.observe(el))}const start=articles.findIndex(el=>location.hash==='#'+el.id);activate(start>=0?start:0);</script></body></html>